# Supabase — copy to .env.local and fill in real values from your Supabase project
# (Project Settings → API). Set the same values in Vercel project env vars.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser. Used by admin route handlers
# (CSV import, session logging, moderation) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
